<!--
  AŞAMA 3 - SOC ozel kural seti.

  Kaynak: fastapi container'indaki wazuh-agent, /var/log/soc/auth_events.log
  dosyasini log_format=json ile tail ediyor (bkz. fastapi/ossec-agent.conf).
  Wazuh'un yerlesik JSON decoder'i, her satirdaki alanlari otomatik olarak
  data.* altina duzlestirir (data.result, data.method, data.reason,
  data.source_ip, data.username, ...) - ayrica ozel bir decoder yazmaya
  gerek yok.

  Kural ID araligi 100100-100199, Wazuh'un "kullaniciya ayrilmis" (local)
  araligindan (100000-119999).
-->
<group name="soc,authentication_failures,">

  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <field name="event_id">\.+</field>
    <description>SOC - Policy Engine (FastAPI) kimlik dogrulama karari</description>
    <options>no_full_log</options>
  </rule>

  <rule id="100101" level="5">
    <if_sid>100100</if_sid>
    <field name="result">failure</field>
    <description>SOC - Basarisiz kimlik dogrulama denemesi ($(username) / $(source_ip) / $(method))</description>
    <group>soc_alert,</group>
  </rule>

  <!-- ---- RADIUS / EAP-TLS tarafi (method != vpn) ---- -->

  <rule id="100102" level="12">
    <if_sid>100101</if_sid>
    <field name="reason">rate_limited</field>
    <field name="method" negate="yes">vpn</field>
    <description>SOC - Kritik Ag Ihlali (Brute-Force / Unauthorized Access) - EAP-TLS/RADIUS uzerinden $(source_ip)</description>
    <group>soc_critical,soc_block_radius,</group>
  </rule>

  <rule id="100104" level="10">
    <if_sid>100101</if_sid>
    <field name="reason">invalid_certificate</field>
    <field name="method" negate="yes">vpn</field>
    <description>SOC - Kritik Ag Ihlali (Certificate Spoofing supheli) - gecersiz/suresi dolmus sertifika ile EAP-TLS denemesi, $(source_ip)</description>
    <group>soc_critical,soc_block_radius,</group>
  </rule>

  <!-- YENİ: certificate_revoked reason'ı, sertifika-iptali kontrolü
       (fastapi/main.py: certificate_revocation_status) eklendiğinde
       ortaya çıktı - orijinal kural setinde yoktu. -->
  <rule id="100107" level="10">
    <if_sid>100101</if_sid>
    <field name="reason">certificate_revoked</field>
    <field name="method" negate="yes">vpn</field>
    <description>SOC - Kritik Ag Ihlali (Iptal Edilmis Sertifika ile Erisim Denemesi) - EAP-TLS uzerinden $(source_ip)</description>
    <group>soc_critical,soc_block_radius,</group>
  </rule>

  <rule id="100105" level="7">
    <if_sid>100101</if_sid>
    <field name="reason">unknown_user</field>
    <field name="method" negate="yes">vpn</field>
    <description>SOC - Bilinmeyen kullanici ile RADIUS/EAP-TLS erisim denemesi, $(source_ip)</description>
    <group>soc_alert,</group>
  </rule>

  <!-- ---- VPN tarafi (method == vpn) ---- -->

  <rule id="100103" level="12">
    <if_sid>100101</if_sid>
    <field name="reason">rate_limited</field>
    <field name="method">vpn</field>
    <description>SOC - Kritik Ag Ihlali (Brute-Force / Unauthorized Access) - VPN uzerinden $(source_ip)</description>
    <group>soc_critical,soc_block_vpn,</group>
  </rule>

  <rule id="100106" level="7">
    <if_sid>100101</if_sid>
    <field name="reason">unknown_user</field>
    <field name="method">vpn</field>
    <description>SOC - Bilinmeyen/calinti kimlik ile VPN erisim denemesi, $(source_ip)</description>
    <group>soc_alert,</group>
  </rule>

  <!-- ---- Bilgilendirme: quarantine / basarili girisler ---- -->

  <rule id="100110" level="3">
    <if_sid>100100</if_sid>
    <field name="reason">quarantined</field>
    <description>SOC - Karantinadaki kimlik yeniden baglandi (VLAN 99), $(username)/$(source_ip)</description>
    <group>soc_info,</group>
  </rule>

</group>
