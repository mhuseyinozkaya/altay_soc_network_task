# Bu dosyayı .env olarak kopyalayıp gerçek değerlerle doldurun.
# .env dosyasını ASLA git'e commit etmeyin (.gitignore'a ekleyin).

# --- PostgreSQL ---
POSTGRES_USER=soc_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=soc_db

# --- FastAPI Policy Engine ---
# DB_DSN'i burada elle yazmanıza gerek yok: docker-compose.yml artık
# fastapi servisinde DB_DSN'i doğrudan ${POSTGRES_USER}/${POSTGRES_PASSWORD}/
# ${POSTGRES_DB}'den derliyor (compose'un otomatik .env interpolasyonuyla,
# env_file içindeki değerlerin aksine bu güvenilir şekilde çalışır).

# --- RADIUS ---
# freeradius/clients.conf.template'teki dmz_network + internal_network
# client'ları ve vpn/client-connect.sh bu değeri kullanır (NAS <-> RADIUS
# protokol seviyesi paylaşılan sır).
RADIUS_SHARED_SECRET=change_this_radius_secret

# freeradius/users.template'teki TÜM test kullanıcıları (testadmin/
# testemployee/testguest) için ortak dahili servis kimlik bilgisi.
# NOT: Bu bir "kullanıcı şifresi" değildir - gerçek kimlik doğrulama
# istemci sertifikasıyla yapılır (+ Postgres üzerinden iptal kontrolü).
# Bu değer yalnızca radtest/PAP testinde ve VPN'in RADIUS'a dahili
# servis çağrısında kullanılır.
VPN_RADIUS_SERVICE_SECRET=change_this_service_secret
