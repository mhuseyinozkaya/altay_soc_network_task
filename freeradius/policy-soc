soc_policy_engine {
    if (reply:Packet-Type == "Access-Accept") {
        # method belirleme: %{Attr:-default} sözdizimi bu FreeRADIUS
        # sürümünde "Unknown module" hatası verdiği için düz if/else
        # kullanılıyor, sonucu Tmp-String-0'a yazıp mods-rest'te
        # onu referans gösteriyoruz.
        if (&NAS-Identifier && &NAS-Identifier == "vpn") {
            update control {
                &Tmp-String-0 := "vpn"
            }
        }
        else {
            update control {
                &Tmp-String-0 := "eap-tls"
            }
        }

        # Gerçek EAP-TLS oturumunda rlm_eap_tls bu attribute'u doldurur;
        # PAP/radtest veya VPN akışında boş kalır (FastAPI bu durumda
        # iptal kontrolünü atlar, bkz. main.py).
        update control {
            &Tmp-String-1 := "%{TLS-Client-Cert-Serial}"
        }

        # YENİ: FastAPI'ye/Wazuh'a bildirilecek "gerçek" kaynak IP.
        # VPN akışında radclient çağrısını fiziksel olarak vpn-gateway
        # container'ı yaptığı için Packet-Src-IP-Address her zaman
        # vpn-gateway'in kendi IP'si olur - vpn/client-connect.sh artık
        # gerçek istemci tünel IP'sini Calling-Station-Id olarak
        # gönderiyor, o varsa onu kullanıyoruz. Access-Accept/Reject
        # kararını ETKİLEMİYOR, sadece loglanan/raporlanan IP'yi
        # düzeltiyor (Wazuh'un doğru bağlantıyı hedefleyebilmesi için).
        if (&Calling-Station-Id) {
            update control {
                &Tmp-String-2 := "%{Calling-Station-Id}"
            }
        }
        else {
            update control {
                &Tmp-String-2 := "%{Packet-Src-IP-Address}"
            }
        }

        rest.authorize
        if (ok || updated) {
            # rest.authorize'ın "ok" olması sadece HTTP isteğinin
            # başarılı olduğunu gösterir - asıl kararı SOC-Result
            # attribute'undan (FastAPI'nin iş mantığı sonucu) okuyoruz.
            if (&control:SOC-Result == "success") {
                update reply {
                    Tunnel-Type             := VLAN
                    Tunnel-Medium-Type      := IEEE-802
                    Tunnel-Private-Group-Id := "%{control:SOC-Vlan}"
                    Reply-Message           := "profile=%{control:SOC-Profile}"
                }
            }
            else {
                update reply {
                    Reply-Message := "Policy Engine reddetti: %{control:SOC-Reason}"
                }
                reject
            }
        }
        else {
            # FastAPI'ye hiç ulaşılamadı (bağlantı hatası vb.)
            update reply {
                Reply-Message := "Policy Engine'e ulasilamadi"
            }
            reject
        }
    }
}
